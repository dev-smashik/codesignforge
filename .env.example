# ============================================================================
# CoDesign Forge — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# All variables below are server-only; do not prefix secrets with NEXT_PUBLIC_.
# ============================================================================

# --- Required ----------------------------------------------------------------

# PostgreSQL connection string used by the Prisma client at runtime.
# Local example: postgresql://USER:PASSWORD@localhost:5432/codesignforge?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codesignforge?schema=public"

# Direct (non-pooled) connection used by Prisma migrations.
# Only required when the runtime connection goes through a pooler
# (e.g. Prisma Postgres / Neon / Supabase pooled URLs). Equals DATABASE_URL locally.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/codesignforge?schema=public"

# Public origin of the app (no trailing slash). Used for OG metadata and
# unsubscribe/account links inside emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (Resend) — required before Phase 4 (signup/welcome email) ---------

RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
# Verified sender, e.g. "CoDesign Forge <hello@yourdomain.com>"
EMAIL_FROM=""

# --- Rate limiting (Upstash Redis) — recommended in production --------------
# Without these, an in-memory limiter is used (single-instance only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Outbox worker (Phase 3) -------------------------------------------------
# Bearer token the cron caller must send to /api/cron/process-outbox.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Social profile URLs. Shown as header icon links; leave unset to hide a
# platform's icon. Replace the .env dev placeholders with real profile URLs
# before launch.
SOCIAL_INSTAGRAM_URL=""
SOCIAL_X_URL=""
SOCIAL_YOUTUBE_URL=""
