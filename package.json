{
  "name": "codesign-forge-coming-soon",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"const p=require('node:path'),c=require('node:child_process');let r=process.cwd(),a=r.split(p.sep),n=a.lastIndexOf('nodevenv');if(n>=0){const t=a.slice(n+1),v=t.findIndex(x=>/^[0-9]/.test(x));if(v<0)throw Error('Cannot resolve cPanel app root');r=p.resolve(p.sep,...a.slice(1,n),...t.slice(0,v));}c.execFileSync('prisma',['generate','--config',p.join(r,'prisma7.config.ts'),'--schema',p.join(r,'prisma/schema.prisma')],{cwd:r,stdio:'inherit'});\"",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
